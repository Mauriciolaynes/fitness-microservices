							"key": "username",
							"value": "admin",
							"type": "text"
						},
						{
							"key": "password",
							"value": "admin123",
							"type": "text"
						}
					]
				},
				"url": {
					"raw": "http://localhost:8180/realms/fitness-realm/protocol/openid-connect/token",
					"protocol": "http",
