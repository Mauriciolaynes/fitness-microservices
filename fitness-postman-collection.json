      "name": "Authentication",
      "item": [
        {
          "name": "1. Keycloak - Get Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) {",
                  "    pm.collectionVariables.set(\"jwt_token\", jsonData.access_token);",
                  "    console.log(\"TOKEN saved.\");",
                  "} else {",
                  "    console.log(\"No token returned.\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "client_id",
                  "value": "fitness-client",
                  "type": "text"
                },
                {
                  "key": "client_secret",
                  "value": "fitness-client-secret",
                  "type": "text"
                },
                {
                  "key": "grant_type",
                  "value": "password",
                  "type": "text"
                },
                {
                  "key": "username",
                  "value": "admin",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "admin123",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "http://localhost:8180/realms/fitness-realm/protocol/openid-connect/token",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8180",
              "path": [
                "realms",
                "fitness-realm",
                "protocol",
                "openid-connect",
                "token"
              ]
            }
          },
          "response": []
        }
      ]
    },
